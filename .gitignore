# ---------- 依赖 ----------
node_modules/
.npm-cache/
.pnpm-store/
.yarn/cache
jspm_packages/

# ---------- 构建产物 ----------
# dist/
dist-ssr/
build/
.vite/
node_modules/.vite/
*.local

# ---------- 数据文件（体积大，不入版本库） ----------
# exactEarth 导出的 AIS 原始数据，单文件约 28-30 MB
exactEarth-*.csv
/*.csv
# 若需提交少量样例数据，放到 sample/ 下并取消下一行注释
# !sample/*.csv

# 预处理产物（npm run prepare-data 生成，可由脚本重建）
# /data/

# ---------- 本地工作区与备份 ----------
# WorkBuddy 本地工作记忆（含会话/记忆文件），不入库
.workbuddy/
*.bak
*.orig
*.rej

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 环境变量与密钥 ----------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 测试 / 缓存 / 临时文件 ----------
coverage/
.nyc_output/
.cache/
.eslintcache
*.tsbuildinfo
*.tmp
*.swp
